{
  "name": "react-agent-bridge",
  "version": "0.1.0",
  "description": "Zero-friction npm framework giving AI agents semantic read-write access to React internal state",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./preflight": {
      "import": "./dist/preflight.js",
      "types": "./dist/preflight.d.ts"
    },
    "./babel-plugin": {
      "require": "./dist/babel-plugin.cjs",
      "import": "./dist/babel-plugin.js",
      "types": "./dist/babel-plugin.d.ts"
    },
    "./redux": {
      "import": "./dist/redux.js",
      "types": "./dist/redux.d.ts"
    },
    "./zustand": {
      "import": "./dist/zustand.js",
      "types": "./dist/zustand.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run"
  },
  "keywords": [
    "react",
    "agent",
    "ai",
    "langgraph",
    "useSyncExternalStore",
    "state"
  ],
  "author": "",
  "license": "MIT",
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-react": "^7.29.7",
    "@babel/types": "^7.29.7",
    "@testing-library/react": "^16.3.2",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^25.9.1",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/ws": "^8.18.1",
    "jsdom": "^24.1.0",
    "typescript": "^5.4.5",
    "vitest": "^1.6.0",
    "ws": "^8.21.0",
    "zustand": "^5.0.14"
  }
}
